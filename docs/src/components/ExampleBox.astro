---
import { Icon } from 'astro-icon/components'

// ExampleBox wraps a schema item's example in a native <details> disclosure so the
// reference page stays scannable: readers expand an example only when they want
// it. Pass `open` to render it expanded by default. The native disclosure
// marker provides the leading caret (it rotates on open for free); the summary
// label flips between "Expand example" and "Collapse example" via the [open]
// attribute (CSS only). The summary's lightbulb glyph matches the eyebrow icons.
//
// ExampleBox also composes an example's parts from slots so call sites stay
// declarative — it renders the eyebrows and the file layout itself:
//   - `manifest` slot -> the envx.yaml, shown in the left column of a
//     "Workspace" group.
//   - `files` slot    -> the namespace file(s), stacked in the right column.
//   - `commands` slot -> the shell commands, shown under a "Commands" group.
//   - default slot    -> raw content for a simple shape snippet (no eyebrows).
//
// The eyebrow labels ("Workspace" / "Commands") are inlined here rather than
// factored into a component: they're two trivial call sites, so a shared
// component earned its keep less than the indirection cost.

interface Props {
  open?: boolean
}

const { open = false } = Astro.props
const hasFiles = Astro.slots.has('files')
const hasWorkspace = Astro.slots.has('manifest') || hasFiles
const hasCommands = Astro.slots.has('commands')
---

<details class="example" open={open}>
  <summary>
    <Icon name="material-symbols:lightbulb-outline" class="h-5 w-5" aria-hidden="true" />
    <span class="label-expand">Expand example</span>
    <span class="label-collapse">Collapse example</span>
  </summary>
  <div class="example-body">
    {
      hasWorkspace && (
        <Fragment>
          <div class="example-label">
            <Icon name="material-symbols:folder-outline" class="h-6 w-6" aria-hidden="true" />
            Workspace
          </div>
          <div class:list={['example-files', { 'example-files--single': !hasFiles }]}>
            <div class="example-files__manifest">
              <slot name="manifest" />
            </div>
            {hasFiles && (
              <div class="example-files__namespaces">
                <slot name="files" />
              </div>
            )}
          </div>
        </Fragment>
      )
    }
    {
      hasCommands && (
        <Fragment>
          <div class="example-label">
            <Icon name="material-symbols:terminal" class="h-6 w-6" aria-hidden="true" />
            Commands
          </div>
          <slot name="commands" />
        </Fragment>
      )
    }
    <slot />
  </div>
</details>

<style>
  .example {
    margin-block: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }

  .example > summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.85rem;
    cursor: pointer;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-gray-2);
    user-select: none;
  }

  .example > summary :global(svg) {
    color: var(--sl-color-gray-3);
  }

  .example > summary:focus-visible {
    outline: 2px solid var(--sl-color-accent-high, var(--sl-color-white));
    outline-offset: -2px;
  }

  .example[open] .label-expand {
    display: none;
  }

  .example:not([open]) .label-collapse {
    display: none;
  }

  .example[open] > summary {
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  /* Eyebrow shown above the Workspace / Commands groups. */
  .example-label {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-block: 1.5rem 0.5rem;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .example-body {
    padding: 0.85rem;
  }

  /* Trim the leading/trailing margins so the box hugs its contents. */
  .example-body > :global(:first-child) {
    margin-block-start: 0;
  }

  .example-body > :global(:last-child) {
    margin-block-end: 0;
  }

  /* Workspace files: the manifest sits in the left column while the namespace
     files stack in the right, so envx.yaml always leads and the files it pulls
     in read down one side instead of wrapping under it. */
  .example-files {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 1rem;
    margin-block-end: 0.5rem;
  }

  /* A manifest-only example (the shape snippets) has no second column. */
  .example-files--single {
    grid-template-columns: 1fr;
  }

  /* Let the grid cells shrink so the code blocks scroll rather than overflow.
     Also cancel Starlight's markdown flow spacing (a `* + *` margin-top that
     lands on the second cell) so both columns start at the same top; the grid
     gap owns any spacing. */
  .example-files__manifest,
  .example-files__namespaces {
    min-width: 0;
    margin: 0;
  }

  .example-files__namespaces {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* The grid/flex gaps own the spacing, so zero the slotted blocks' margins.
     Target direct children generically to avoid coupling to Expressive Code's
     internal markup. */
  .example-files__manifest > :global(*),
  .example-files__namespaces > :global(*) {
    margin: 0;
  }

  /* Collapse to a single column when there isn't room for two side by side. */
  @media (max-width: 50rem) {
    .example-files {
      grid-template-columns: 1fr;
    }
  }
</style>
