{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "minimumReleaseAge": "3 days",
  "timezone": "America/Chicago",
  "lockFileMaintenance": {
    "schedule": ["after 4am and before 6am"],
    "prHourlyLimit": 0
  },
  "packageRules": [
    {
      "description": "Fallback group for remaining non-major deps",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies"
    },
    {
      "description": "Group devcontainer updates; require dashboard approval",
      "matchFileNames": [".devcontainer/**"],
      "groupName": "devcontainer",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group root development tools",
      "matchFileNames": ["mise.toml", "package.json"],
      "groupName": "root"
    },
    {
      "description": "Group GitHub workflow/action updates",
      "matchFileNames": [".github/**"],
      "groupName": "github"
    },
    {
      "description": "Group Go CLI app updates",
      "matchFileNames": ["app/**"],
      "groupName": "app"
    },
    {
      "description": "Group docs site updates",
      "matchFileNames": ["docs/**"],
      "groupName": "docs"
    }
  ]
}
