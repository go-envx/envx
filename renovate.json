{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "prCreation": "immediate",
    "automerge": true
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "groupName": "non-major dependencies",
      "description": "Update all non-major dependencies.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    },
    {
      "groupName": "non-major dependencies",
      "description": "Docker digest updates (base image rebuilds) have no meaningful release age.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAge": null
    },
    {
      "description": "Major updates require manual approval from the Dependency Dashboard before a PR is opened.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "devcontainer",
      "description": "Devcontainer updates require manual approval from the Dependency Dashboard before a PR is opened.",
      "matchFileNames": [".devcontainer/**"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Python minor releases (e.g. 3.12 to 3.13) require manual approval from the Dependency Dashboard before a PR is opened.",
      "matchManagers": ["mise"],
      "matchDepNames": ["python"],
      "versioning": "regex:^(?<compatibility>\\d+)\\.(?<major>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "groupName": "python docker image",
      "description": "Python base image minor releases (e.g. 3.12 to 3.13) require manual approval from the Dependency Dashboard before a PR is opened.",
      "matchDatasources": ["docker"],
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["minor", "major"],
      "dependencyDashboardApproval": true
    }
  ]
}
