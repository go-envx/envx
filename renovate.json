{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "prCreation": "immediate"
  },
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "groupName": "non-major dependencies",
      "description": "Update all non-major dependencies.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    },
    {
      "groupName": "non-major dependencies",
      "description": "Docker digest updates (base image rebuilds) have no meaningful release age.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAge": null
    },
    {
      "description": "Major updates require manual approval from the Dependency Dashboard before a PR is opened.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "devcontainer",
      "description": "Devcontainer updates require manual approval from the Dependency Dashboard before a PR is opened.",
      "matchFileNames": [".devcontainer/**"],
      "dependencyDashboardApproval": true
    }
  ]
}
