{
	// Git Settings
	"git.autofetch": true,
	"git.confirmSync": false,
	"git.pruneOnFetch": true,
	// Editor Settings
	"editor.codeActionsOnSave": {
		"source.fixAll.biome": "explicit"
	},
	"editor.defaultFormatter": "biomejs.biome",
	"editor.emptySelectionClipboard": true,
	"editor.formatOnSave": true,
	"editor.rulers": [88],
	"editor.tabSize": 2,
	// Files Settings
	"files.insertFinalNewline": true,
	"files.trimFinalNewlines": true,
	"files.trimTrailingWhitespace": true,
	// JSON Schemas
	"json.schemaDownload.trustedDomains": {
		"https://biomejs.dev/": true,
		"https://docs.renovatebot.com/": true
	},
	// Go Settings
	// gopls is installed/pinned via mise (see mise.toml), so stop the Go
	// extension from checking the module proxy for updates on every activation —
	// that check is what triggers the recurring "update Go tools" notification.
	"go.toolsManagement.checkForUpdates": "off",
  // Text Overrides
  "[plaintext]": {
      "editor.wordWrap": "bounded",
      "editor.wordWrapColumn": 88,
      "editor.rulers": [88]
  },
  "[markdown]": {
      "editor.wordWrap": "bounded",
      "editor.wordWrapColumn": 88,
      "editor.rulers": [88]
  },
  "[mdx]": {
      "editor.wordWrap": "bounded",
      "editor.wordWrapColumn": 88,
      "editor.rulers": [88]
  },
	// Extensions Recommendations
	"biome.suggestInstallingGlobally": false,
	"extensions.ignoreRecommendations": true
}
